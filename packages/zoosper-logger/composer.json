{
    "name": "zoosper/logger",
    "description": "Zoosper-owned multi-channel logging boundary backed by Marko file logging.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/log": "0.8.5",
        "marko/log-file": "0.8.5"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Logger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Logger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        }
    }
}
