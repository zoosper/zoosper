{
    "name": "zoosper/errors",
    "description": "Zoosper's loud-errors exception, sensitive-value redaction, and CLI/web error display package, built on Marko's exception base class and error formatters.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/core": "^0.8",
        "marko/errors": "^0.8",
        "marko/errors-simple": "^0.8"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Errors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Errors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        }
    }
}
