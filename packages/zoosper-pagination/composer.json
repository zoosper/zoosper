{
    "name": "zoosper/pagination",
    "description": "Zoosper-owned pagination contracts and Marko offset-pagination adapter.",
    "type": "library",
    "license": "MIT",
    "require": {
        "marko/pagination": "0.8.5",
        "php": "^8.5"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Pagination\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Pagination\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        }
    }
}
