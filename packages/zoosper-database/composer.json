{
    "name": "zoosper/database",
    "description": "Database connection and schema management for Zoosper CMS",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Database\\Tests\\": "tests/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        }
    }
}
