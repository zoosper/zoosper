{
    "name": "zoosper/audit",
    "description": "Admin activity and login history auditing for Zoosper CMS",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "zoosper/grid": "dev-dev",
        "zoosper/pagination": "dev-dev"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Audit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        }
    }
}
