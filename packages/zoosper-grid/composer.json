{
    "name": "zoosper/grid",
    "description": "Reusable grid definitions, criteria, rendering, extension registry and CSV export for Zoosper.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "zoosper/core": "dev-dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Grid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Grid\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        }
    }
}
