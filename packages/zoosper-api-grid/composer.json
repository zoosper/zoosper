{
    "name": "zoosper/api-grid",
    "description": "Transport and mapping adapters for external API-backed Zoosper grids.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "ext-curl": "*",
        "php": "^8.5",
        "zoosper/grid": "dev-dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\ApiGrid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\ApiGrid\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        }
    }
}
