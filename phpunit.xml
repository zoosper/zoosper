<?xml version="1.0" encoding="UTF-8"?>
<!--
    Zoosper CMS - PHPUnit / Pest configuration (Phase 1.21, co-located tests)

    Tests are CO-LOCATED inside each module's own tests/ folder so that a module
    stays fully self-contained: drop the module folder in and its tests come with
    it; delete the folder and its tests go too. There is deliberately NO root
    tests/ directory. The glob patterns below discover every module's tests.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>app/*/tests/Unit</directory>
            <directory>modules/*/tests/Unit</directory>
            <directory>modules/*/*/tests/Unit</directory>
            <directory>packages/*/tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>app/*/tests/Feature</directory>
            <directory>modules/*/tests/Feature</directory>
            <directory>modules/*/*/tests/Feature</directory>
            <directory>packages/*/tests/Feature</directory>
        </testsuite>
    </testsuites>

    <!--
        FIX (2026-07-30): FrontendBootTest and any other Feature test that
        calls ApplicationFactory::create() boot the real, full application
        end-to-end. That constructs the full service container, including
        admin/auth services. SecretProtector's factory correctly throws when
        no 2FA encryption key is available, so the Pest/PHPUnit process needs
        its own test-only key just like a real environment needs one in .env.

        This value is test-only and deliberately fake. Never use it in any
        real environment.
    -->
    <php>
        <env name="TWO_FACTOR_ENCRYPTION_KEY" value="test-only-not-a-real-secret-do-not-use-in-any-real-environment"/>
    </php>

    <source>
        <include>
            <directory>app</directory>
            <directory>modules</directory>
            <directory>packages</directory>
        </include>
    </source>

    <coverage>
        <report>
            <text outputFile="php://stdout" showOnlySummary="true"/>
        </report>
    </coverage>
</phpunit>
