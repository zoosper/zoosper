{var $stylesheetUrl = isset($cdn) ? $cdn->staticAsset('/static/themes/default/assets/css/app.css') : '/static/themes/default/assets/css/app.css'}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{$title ?? 'Zoosper'}</title>
    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg">
    <link rel="stylesheet" href="{$stylesheetUrl}">
</head>
<body>
{block body.start}{/block}
<header class="site-header">
    <a href="/" class="site-logo" aria-label="Zoosper home"><img src="/assets/brand/logo.svg" alt="" width="36" height="36"><span>Zoosper</span></a>

{if ($navigationHtml ?? '') !== ''}
    <nav class="site-navigation cms-site-navigation" aria-label="Primary navigation">
        {$navigationHtml|noescape}
    </nav>
{/if}
</header>
<main class="site-main page-shell">
{if ($breadcrumbsHtml ?? '') !== ''}
    <nav class="cms-breadcrumbs" aria-label="Breadcrumb">
        {$breadcrumbsHtml|noescape}
    </nav>
{/if}

    {$content|noescape}
</main>
<footer class="site-footer">
    <small>Powered by Zoosper</small>
</footer>
{block body.end}{/block}
</body>
</html>
