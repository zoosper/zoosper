#!/usr/bin/env php
<?php

declare(strict_types=1);

use Marko\Config\ConfigRepositoryInterface;
use Zoosper\Core\Config\ApplicationConfigLoader;
use Zoosper\Core\Config\ConfigRepository;
use Zoosper\Core\Config\MarkoConfigRepositoryAdapter;
use Zoosper\Core\Console\ConsoleApplication;
use Zoosper\Core\Console\ConsoleOutput;
use Zoosper\Core\Console\ConsoleOptions;
use Zoosper\Core\Console\BuiltIn\CacheClearCommand;
use Zoosper\Core\Console\BuiltIn\CompileCommand;
use Zoosper\Core\Console\BuiltIn\ManifestCheckCommand;
use Zoosper\Core\Console\BuiltIn\ManifestStatusCommand;
use Zoosper\Core\Console\BuiltIn\MigrateCommand;
use Zoosper\Core\Console\BuiltIn\ReleaseCheckCommand;
use Zoosper\Core\Console\BuiltIn\VersionCommand;
use Zoosper\Core\Release\ReleaseCheck;
use Zoosper\Core\Console\BuiltIn\DeployCommand;
use Zoosper\Core\Console\BuiltIn\MakeConsoleCommand;
use Zoosper\Core\Console\BuiltIn\MakeModuleCommand;
use Zoosper\Core\Console\BuiltIn\MakePackageModuleCommand;
use Zoosper\Core\Console\ModuleConsoleCommandLoader;
use Zoosper\Core\Container\ServiceContainer;
use Zoosper\Core\Container\ServiceProviderLoader;
use Zoosper\Core\Database\ConnectionFactory;
use Zoosper\Core\Database\Migrator;
use Zoosper\Core\Database\PdoConnectionProvider;
use Zoosper\Errors\ConsoleExceptionFormatter;
use Zoosper\Core\Log\ErrorHandler;
use Zoosper\Core\Log\LogManager;
use Zoosper\Core\Module\ModuleManifestCompiler;
use Zoosper\Core\Module\ModuleManifestStatus;
use Zoosper\Core\Module\ModuleRegistry;
use Zoosper\Core\Scaffold\ConsoleCommandScaffolder;
use Zoosper\Core\Scaffold\ModuleScaffolder;
use Zoosper\Core\Scaffold\PackageModuleScaffolder;

require dirname(__DIR__) . '/bootstrap/autoload.php';

$basePath = dirname(__DIR__);
$modules = new ModuleRegistry($basePath);
$config = (new ApplicationConfigLoader($basePath, $modules))->load();
$command = $argv[1] ?? 'help';
$options = ConsoleOptions::parse(array_slice($argv, 2));
if (in_array($command, ['module:manifest:status', 'module:manifest:check'], true)) {
    $format = $options['format'] ?? 'text';
    if (!in_array($format, ['text', 'json'], true)) {
        fwrite(STDERR, "Unsupported format '{$format}'. Expected text or json.\n");
        exit(2);
    }
}

$logManager = new LogManager($config, $basePath);
$errorHandler = new ErrorHandler($logManager->exceptions());
$errorHandler->register();

$connection = new PdoConnectionProvider(
    static fn (): PDO => (new ConnectionFactory($config, $basePath))->create(),
);

try {
    $operationalCommandFactories = [
        'migrate' => static fn () => new MigrateCommand(new Migrator($connection->get(), $basePath . '/database/migrations', $modules)),
        'compile' => static fn () => new CompileCommand(new ModuleManifestCompiler($basePath)),
        'cache:clear' => static fn () => new CacheClearCommand(new ModuleManifestCompiler($basePath)),
        'module:manifest:status' => static fn () => new ManifestStatusCommand(new ModuleManifestStatus($basePath)),
        'module:manifest:check' => static fn () => new ManifestCheckCommand(new ModuleManifestStatus($basePath)),
        'deploy' => static fn () => new DeployCommand(new Migrator($connection->get(), $basePath . '/database/migrations', $modules), new ModuleManifestCompiler($basePath), new ModuleManifestStatus($basePath)),
        'make:module' => static fn () => new MakeModuleCommand(new ModuleScaffolder($basePath)),
        'make:package-module' => static fn () => new MakePackageModuleCommand(new PackageModuleScaffolder($basePath)),
        'make:command' => static fn () => new MakeConsoleCommand(new ConsoleCommandScaffolder($basePath)),
        'version' => static fn () => new VersionCommand($basePath),
        'release:check' => static fn () => new ReleaseCheckCommand(new ReleaseCheck($basePath)),
    ];
    if (isset($operationalCommandFactories[$command])) {
        $operationalCommand = $operationalCommandFactories[$command]();
        exit($operationalCommand->run(array_slice($argv, 2), new ConsoleOutput()));
    }

    if ($command === 'help' || $command === 'list') {
        $application = new ConsoleApplication(builtInCommands());

        exit($application->run($command, [], new ConsoleOutput()));
    }
    $output = new ConsoleOutput();
    $moduleCommands = loadModuleCommands($basePath, $config, $connection, $modules);
    $application = new ConsoleApplication(builtInCommands(), $moduleCommands);

    exit($application->run($command, array_slice($argv, 2), $output));
} catch (Throwable $exception) {
    fwrite(STDERR, (new ConsoleExceptionFormatter())->format($exception));
    exit(1);
}

/** @return list<string> */
function builtInCommands(): array
{
    return [
        'migrate',
        'compile',
        'cache:clear',
        'module:manifest:status',
        'module:manifest:check',
        'deploy',
        'version',
        'release:check',
        'make:module Vendor_Module',
        'make:package-module Vendor/Module',
        'make:command Vendor_Module CommandClass --name=vendor:task:run --description="Describe the command"',
    ];
}

/** @return array<string, \Zoosper\Core\Console\ConsoleCommandInterface> */
function loadModuleCommands(
    string $basePath,
    ConfigRepository $config,
    PdoConnectionProvider $connection,
    ModuleRegistry $modules,
): array
{
    $services = new ServiceContainer();
    $services->set(ConfigRepository::class, $config);
    $services->set(ConfigRepositoryInterface::class, new MarkoConfigRepositoryAdapter($config));
    $services->set(ModuleRegistry::class, $modules);
    $services->factory(PDO::class, static fn (): PDO => $connection->get());

    $logManager = new LogManager($config, $basePath);
    $errorHandler = new ErrorHandler($logManager->exceptions());
    $services->set(LogManager::class, $logManager);
    $services->set(ErrorHandler::class, $errorHandler);
    $services->set('logger.default', $logManager->default());
    $services->set('logger.exception', $logManager->exceptions());

    (new ServiceProviderLoader($modules, $services))->register();

    return (new ModuleConsoleCommandLoader($modules, $services))->load();
}
