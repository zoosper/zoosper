#!/usr/bin/env php
<?php

declare(strict_types=1);

use Marko\Config\ConfigRepositoryInterface;
use Zoosper\Core\Config\ApplicationConfigLoader;
use Zoosper\Core\Config\ConfigRepository;
use Zoosper\Core\Config\MarkoConfigRepositoryAdapter;
use Zoosper\Core\Console\ConsoleApplication;
use Zoosper\Core\Console\ConsoleOutput;
use Zoosper\Core\Console\ModuleConsoleCommandLoader;
use Zoosper\Core\Container\ServiceContainer;
use Zoosper\Core\Container\ServiceProviderLoader;
use Zoosper\Core\Database\ConnectionFactory;
use Zoosper\Core\Database\Migrator;
use Zoosper\Core\Database\PdoConnectionProvider;
use Zoosper\Errors\ConsoleExceptionFormatter;
use Zoosper\Core\Log\ErrorHandler;
use Zoosper\Core\Log\LogManager;
use Zoosper\Core\Module\ModuleManifestCompiler;
use Zoosper\Core\Module\ModuleRegistry;
use Zoosper\Core\Scaffold\ConsoleCommandScaffolder;
use Zoosper\Core\Scaffold\ModuleScaffolder;
use Zoosper\Core\Scaffold\PackageModuleScaffolder;

require dirname(__DIR__) . '/bootstrap/autoload.php';

$basePath = dirname(__DIR__);
$modules = new ModuleRegistry($basePath);
$config = (new ApplicationConfigLoader($basePath, $modules))->load();
$command = $argv[1] ?? 'help';
$options = parseOptions(array_slice($argv, 2));

$logManager = new LogManager($config, $basePath);
$errorHandler = new ErrorHandler($logManager->exceptions());
$errorHandler->register();

$connection = new PdoConnectionProvider(
    static fn (): PDO => (new ConnectionFactory($config, $basePath))->create(),
);

try {
    if ($command === 'help' || $command === 'list') {
        $application = new ConsoleApplication(builtInCommands());

        exit($application->run($command, [], new ConsoleOutput()));
    }
    if ($command === 'migrate') {
        (new Migrator($connection->get(), $basePath . '/database/migrations', $modules))->migrate();
        echo "Zoosper migrations completed.\n";
        exit(0);
    }

    if ($command === 'compile') {
        $compiledModules = (new ModuleManifestCompiler($basePath))->compile();
        echo 'Compiled module manifest: ' . count($compiledModules) . " module(s).\n";
        foreach ($compiledModules as $module) {
            echo "  - {$module->name} ({$module->source})\n";
        }
        echo "\nCache written to: var/cache/modules.php\n";
        echo "Run `bin/zoosper cache:clear` at any time to force live discovery again.\n";
        exit(0);
    }

    if ($command === 'cache:clear') {
        $compiler = new ModuleManifestCompiler($basePath);
        $wasCompiled = $compiler->isCompiled();
        $compiler->clear();
        echo $wasCompiled
            ? "Compiled module manifest cache cleared.\n"
            : "No compiled module manifest cache was present (already using live discovery).\n";
        exit(0);
    }

    if ($command === 'deploy') {
        echo "== Zoosper deploy ==\n\n";

        echo "[1/3] Regenerating Composer autoloader (composer dump-autoload)...\n";
        echo "      NOTE: this shells out to whatever 'composer' resolves to on your\n";
        echo "      PATH. If you use a version-pinned alias (e.g. a php8.5-specific\n";
        echo "      composer wrapper) and are not certain PATH resolves to it the same\n";
        echo "      way, run that alias manually first and re-run deploy afterward —\n";
        echo "      an autoloader regenerated with the wrong PHP/Composer version is\n";
        echo "      worse than not regenerating it at all.\n";
        passthru('composer dump-autoload', $autoloadExitCode);
        if ($autoloadExitCode !== 0) {
            fwrite(STDERR, "\nAutoload generation failed (exit code {$autoloadExitCode}). Aborting deploy before any schema changes.\n");
            exit(1);
        }

        echo "\n[2/3] Applying database migrations (bin/zoosper migrate)...\n";
        (new Migrator($connection->get(), $basePath . '/database/migrations', $modules))->migrate();
        echo "Migrations applied.\n";

        echo "\n[3/3] Compiling module manifest (bin/zoosper compile)...\n";
        $compiledModules = (new ModuleManifestCompiler($basePath))->compile();
        echo 'Compiled ' . count($compiledModules) . " module(s) to var/cache/modules.php\n";

        echo "\n== Deploy complete ==\n";
        echo "Reminder: this does NOT run your test suite. Run `composer test` (or your\n";
        echo "usual alias) to verify before considering this build done.\n";
        exit(0);
    }

    if ($command === 'make:module') {
        $moduleName = $argv[2] ?? '';
        $result = (new ModuleScaffolder($basePath))->scaffold($moduleName);

        echo "Created module {$result->moduleName}\n";
        echo "Namespace: {$result->namespace}\n";
        echo "Path: {$result->modulePath}\n";
        echo "Files:\n";
        foreach ($result->createdFiles as $file) {
            echo "  - {$file}\n";
        }
        echo "\nNext: add the PSR-4 autoload snippet from {$result->modulePath}/README.md if you add PHP classes.\n";
        exit(0);
    }

    if ($command === 'make:package-module') {
        $moduleName = $argv[2] ?? '';
        $result = (new PackageModuleScaffolder($basePath))->scaffold($moduleName);

        echo "Created package module {$result->moduleName}\n";
        echo "Package: {$result->packageName}\n";
        echo "Namespace: {$result->namespace}\n";
        echo "Path: {$result->packagePath}\n";
        echo "Files:\n";
        foreach ($result->createdFiles as $file) {
            echo "  - {$file}\n";
        }
        echo "\nNext: run PHP=php8.5 composer dump-autoload and vendor/bin/pest {$result->packagePath}/tests/Unit.\n";
        exit(0);
    }

    if ($command === 'make:command') {
        $moduleName = $argv[2] ?? '';
        $className = $argv[3] ?? '';
        $commandName = required($options, 'name');
        $description = $options['description'] ?? '';

        $result = (new ConsoleCommandScaffolder($basePath))->scaffold($moduleName, $className, $commandName, $description);

        echo "Created console command {$result->commandName}\n";
        echo "Module: {$result->moduleName}\n";
        echo "Class: {$result->commandClass}\n";
        echo "Files:\n";
        foreach ($result->createdFiles as $file) {
            echo "  - {$file}\n";
        }
        echo "\nRun it with: php bin/zoosper {$result->commandName}\n";
        exit(0);
    }

    $output = new ConsoleOutput();
    $moduleCommands = loadModuleCommands($basePath, $config, $connection->get(), $modules);
    $application = new ConsoleApplication(builtInCommands(), $moduleCommands);

    exit($application->run($command, array_slice($argv, 2), $output));
} catch (Throwable $exception) {
    fwrite(STDERR, (new ConsoleExceptionFormatter())->format($exception));
    exit(1);
}

/** @return list<string> */
function builtInCommands(): array
{
    return [
        'migrate',
        'compile',
        'cache:clear',
        'deploy',
        'make:module Vendor_Module',
        'make:package-module Vendor/Module',
        'make:command Vendor_Module CommandClass --name=vendor:task:run --description="Describe the command"',
    ];
}

/** @return array<string, \Zoosper\Core\Console\ConsoleCommandInterface> */
function loadModuleCommands(
    string $basePath,
    ConfigRepository $config,
    PDO $pdo,
    ModuleRegistry $modules,
): array
{
    $services = new ServiceContainer();
    $services->set(ConfigRepository::class, $config);
    $services->set(ConfigRepositoryInterface::class, new MarkoConfigRepositoryAdapter($config));
    $services->set(ModuleRegistry::class, $modules);
    $services->set(PDO::class, $pdo);

    $logManager = new LogManager($config, $basePath);
    $errorHandler = new ErrorHandler($logManager->exceptions());
    $services->set(LogManager::class, $logManager);
    $services->set(ErrorHandler::class, $errorHandler);
    $services->set('logger.default', $logManager->default());
    $services->set('logger.exception', $logManager->exceptions());

    (new ServiceProviderLoader($modules, $services))->register();

    return (new ModuleConsoleCommandLoader($modules, $services))->load();
}

/** @param list<string> $args @return array<string, string> */
function parseOptions(array $args): array
{
    $options = [];
    foreach ($args as $arg) {
        if (!str_starts_with($arg, '--') || !str_contains($arg, '=')) {
            continue;
        }
        [$key, $value] = explode('=', substr($arg, 2), 2);
        $options[$key] = $value;
    }
    return $options;
}

/** @param array<string, string> $options */
function required(array $options, string $key): string
{
    if (!array_key_exists($key, $options) || $options[$key] === '') {
        fwrite(STDERR, "Missing required option: --{$key}=...\n");
        exit(1);
    }
    return $options[$key];
}

