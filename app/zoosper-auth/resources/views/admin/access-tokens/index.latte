{var $e = fn($value) => htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8')}
<section class="card">
<h1>Personal Access Tokens</h1>
<p class="muted">Create credentials for API integrations. Tokens are limited to the selected scopes and remain owned by your current Admin identity.</p>
{if $oneTimeToken}
<div class="notice success"><h2>Copy this token now</h2><p>This credential cannot be shown again.</p><pre>{$oneTimeToken}</pre></div>
{/if}
{if $error}<div class="notice error">{$error}</div>{/if}
<form method="post" action="{$createUrl}" class="page-form">
<input type="hidden" name="_csrf_token" value="{$csrfToken}">
<label>Name <input type="text" name="name" maxlength="120" value="{$submitted['name'] ?? ''}" required></label>
<label>Expiry (optional) <input type="datetime-local" name="expires_at" value="{$submitted['expires_at'] ?? ''}"></label>
<fieldset><legend>Scopes</legend>
{foreach $scopes as $scope}<label><input type="checkbox" name="scopes[]" value="{$scope}" {if in_array($scope, $submitted['scopes'] ?? [], true)}checked{/if}> {$scope}</label>{/foreach}
</fieldset>
<button type="submit" class="button primary">Create token</button>
</form>
</section>
<section class="card"><h2>Your tokens</h2>
{if count($tokens) === 0}<p>No Personal Access Tokens have been created.</p>{else}
<table><thead><tr><th>Name</th><th>Public ID</th><th>Scopes</th><th>Expires</th><th>Last used</th><th>Status</th><th>Action</th></tr></thead><tbody>
{foreach $tokens as $token}<tr><td>{$token->name}</td><td><code>{$token->publicId}</code></td><td>{implode(', ', $token->scopes)}</td><td>{$token->expiresAt ?? 'Never'}</td><td>{$token->lastUsedAt ?? 'Never'}</td><td>{if $token->isRevoked()}Revoked{elseif $token->isExpired()}Expired{else}Active{/if}</td><td>{if !$token->isRevoked()}<form method="post" action="{$revokeUrl($token->id)}"><input type="hidden" name="_csrf_token" value="{$csrfToken}"><button type="submit" class="button button--danger">Revoke</button></form>{/if}</td></tr>{/foreach}
</tbody></table>{/if}
</section>
