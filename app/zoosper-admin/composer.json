{
    "name": "zoosper/admin",
    "description": "Zoosper_Admin module for Zoosper CMS.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "zoosper/core": "dev-dev",
        "zoosper/auth": "dev-dev",
        "zoosper/theme": "dev-dev",
        "zoosper/errors": "dev-dev"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Admin\\": "src/"
        }
    },
    "extra": {
        "zoosper": {
            "module": "module.php",
            "name": "Zoosper_Admin"
        },
        "marko": {
            "module": true
        }
    }
}
