{
    "name": "zoosper/site",
    "description": "Zoosper_Site module for Zoosper CMS.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "zoosper/core": "dev-dev"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Site\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Site\\Tests\\": "tests/"
        }
