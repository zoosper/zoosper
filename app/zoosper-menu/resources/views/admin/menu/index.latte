<section class="card"><div class="admin-page-heading"><h2>Menus</h2><a class="button" href="/admin/menus/create">Create menu</a></div>
{if !$menus}<p class="muted">No menus exist yet.</p>{else}<table class="admin-table"><thead><tr><th>Label</th><th>Code</th><th>Site</th><th>Status</th><th></th></tr></thead><tbody>{foreach $menus as $menu}<tr><td>{$menu->label}</td><td><code>{$menu->code}</code></td><td>{$menu->siteId}</td><td>{$menu->status}</td><td><a href="/admin/menus/{$menu->id}/edit">Edit</a></td></tr>{/foreach}</tbody></table>{/if}</section>
