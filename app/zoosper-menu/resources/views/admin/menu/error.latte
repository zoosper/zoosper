<section class="card marko-error marko-error--loud menu-runtime-error" role="alert">
    <p class="menu-runtime-error__label">Marko runtime error</p>
    <h2>{$heading}</h2>
    <p><strong>Operation:</strong> {$operation}</p>
    <p class="menu-runtime-error__message"><strong>{$message}</strong></p>
    <details open><summary>Technical details</summary><p><code>{$exceptionClass}</code></p></details>
    <p><a class="button" href="{$returnUrl}">Return to menu form</a></p>
</section>
