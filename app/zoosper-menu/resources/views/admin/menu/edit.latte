<section class="card"><h2>{$menu ? 'Edit menu' : 'Create menu'}</h2><form method="post" action="{$saveUrl}"><input type="hidden" name="_csrf_token" value="{$token}"><label>Site <select name="site_id" required>{foreach $sites as $site}<option value="{$site['id']}" selected={$menu && $menu->siteId === $site['id']}>{$site['label']}</option>{/foreach}</select></label><label>Code <input name="code" value="{$menu?->code}" required pattern="[a-zA-Z0-9_-]+"></label><label>Label <input name="label" value="{$menu?->label}" required></label><label>Status <select name="status"><option value="active" selected={$menu?->status === 'active'}>Active</option><option value="inactive" selected={$menu?->status === 'inactive'}>Inactive</option></select></label><button class="button" type="submit">Save menu</button></form></section>
{if $menu}<details class="card menu-items-workspace" open><summary><strong>Menu items</strong></summary>{foreach $items as $item}<form method="post" action="{$itemsUrl}/{$item->id}" class="menu-item-form"><input type="hidden" name="_csrf_token" value="{$token}"><label>Label <input name="label" value="{$item->label}" required></label><label>Parent <select name="parent_id"><option value="">Top level</option>{foreach $items as $parent}{if $parent->id !== $item->id}<option value="{$parent->id}" selected={$item->parentId === $parent->id}>{$parent->label}</option>{/if}{/foreach}</select></label><label>Page <select name="page_id"><option value="">External URL</option>{foreach $pages as $page}<option value="{$page['id']}" selected={$item->pageId === $page['id']}>{$page['label']}</option>{/foreach}</select></label><label>URL <input name="url" value="{$item->url}" inputmode="url" placeholder="https://example.com or /relative-path"></label><label>Position <input name="position" type="number" min="0" value="{$item->position}"></label><input type="hidden" name="target" value="{$item->target}"><input type="hidden" name="status" value="{$item->status}"><button type="submit">Update</button><button type="submit" formaction="{$itemsUrl}/{$item->id}/delete" class="button button--danger">Delete</button></form>{else}<p class="muted">No items yet.</p>{/foreach}</details>
<section class="card"><h3>Add item</h3><form method="post" action="{$itemsUrl}"><input type="hidden" name="_csrf_token" value="{$token}"><label>Label <input name="label" required></label><label>Parent <select name="parent_id"><option value="">Top level</option>{foreach $items as $parent}<option value="{$parent->id}">{$parent->label}</option>{/foreach}</select></label><label>Published page <select name="page_id"><option value="">External URL</option>{foreach $pages as $page}<option value="{$page['id']}">{$page['label']}</option>{/foreach}</select></label><label>External URL <input name="url" type="url" inputmode="url" placeholder="https://example.com or /relative-path"></label><label>Position <input name="position" type="number" min="0" value="0"></label><label>Target <select name="target"><option value="_self">Same window</option><option value="_blank">New window</option></select></label><input type="hidden" name="status" value="active"><button class="button" type="submit">Add item</button></form></section>
{$lifecycleHtml|noescape}{/if}
