<section class="card"><h2>{$menu ? 'Edit menu' : 'Create menu'}</h2><form method="post" action="{$menu ? '/admin/menus/' . $menu->id . '/edit' : '/admin/menus'}"><label>Site ID <input name="site_id" type="number" min="1" value="{$menu?->siteId}"></label><label>Code <input name="code" value="{$menu?->code}"></label><label>Label <input name="label" value="{$menu?->label}"></label><label>Status <select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label><button class="button" type="submit">Save menu</button></form></section>
{if $menu}<section class="card"><h3>Items</h3>{if $items}<ol>{foreach $items as $item}<li>{$item->label} <span class="muted">{$item->url ?? 'Page ' . $item->pageId}</span></li>{/foreach}</ol>{/if}<h3>Add item</h3><form method="post" action="/admin/menus/{$menu->id}/items"><label>Label <input name="label"></label><label>Parent ID <input name="parent_id" type="number"></label><label>Page ID <input name="page_id" type="number"></label><label>External URL <input name="url"></label><label>Position <input name="position" type="number" min="0" value="0"></label><label>Target <select name="target"><option value="_self">Same window</option><option value="_blank">New window</option></select></label><button class="button" type="submit">Add item</button></form></section>{/if}
