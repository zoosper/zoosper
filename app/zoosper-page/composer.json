{
    "name": "zoosper/page",
    "description": "Zoosper_Page module for Zoosper CMS.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "zoosper/auth": "dev-dev",
        "zoosper/cache": "dev-dev",
        "zoosper/core": "dev-dev",
        "zoosper/grid": "dev-dev",
        "zoosper/media": "dev-dev",
        "zoosper/pagination": "dev-dev",
        "zoosper/seo": "dev-dev",
        "zoosper/site": "dev-dev",
        "zoosper/theme": "dev-dev"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Page\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Page\\Tests\\": "tests/"
        }
    }
}
