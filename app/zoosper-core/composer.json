{
    "name": "zoosper/core",
    "description": "Zoosper_Core module for Zoosper CMS.",
    "type": "zoosper-module",
    "license": "MIT",
    "require": {
        "ext-pdo": "*",
        "php": "^8.5",
        "zoosper/cache": "^0.3.1@alpha",
        "zoosper/config": "^0.3.1@alpha",
        "zoosper/database": "^0.3.1@alpha",
        "zoosper/errors": "^0.3.1@alpha",
        "zoosper/logger": "^0.3.1@alpha",
        "zoosper/scoped-config": "^0.3.1@alpha"
    },
    "autoload": {
        "psr-4": {
            "Zoosper\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoosper\\Core\\Tests\\": "tests/"
        }
    }
}
