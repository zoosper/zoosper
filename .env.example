# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Zoosper
# SECURITY: staging and production enforce secure sessions and rate limiting; unknown or empty values fail boot.
# Never deploy a public environment with APP_ENV=local.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080

# APP_KEY currently has NO direct consumers of its own in this codebase (it
# only ever serves as a fallback default for TWO_FACTOR_ENCRYPTION_KEY below,
# and only when that variable is not set) — confirmed via a repo-wide search.
# Still: never leave this as the literal placeholder value in any shared or
# production environment. Generate a real one with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-me-before-production

# -----------------------------------------------------------------------------
# Two-factor authentication (TOTP)
# -----------------------------------------------------------------------------
# REQUIRED before enabling 2FA for any real admin account. Generate a real,
# unique value — never reuse APP_KEY or any other key for this:
#   php -r "echo bin2hex(random_bytes(32));"
# If this is ever unset, the app refuses to build a working 2FA secret
# protector (fails loudly at the point of use) rather than silently falling
# back to an insecure default.
TWO_FACTOR_ENCRYPTION_KEY=

# If you ever ROTATE TWO_FACTOR_ENCRYPTION_KEY (e.g. because the previous
# value was ever exposed, or as routine hygiene), move its OLD value here
# first — as a comma-separated list, most-recently-retired key first — or
# every admin who enrolled in 2FA under the old key will be permanently
# locked out on their next login. Each successful login automatically
# re-encrypts that admin's secret under the CURRENT key, so once every admin
# has logged in at least once since the rotation, the old key(s) can be
# safely removed from this list.
# Example: TWO_FACTOR_PREVIOUS_ENCRYPTION_KEYS=<previous-key-value>
TWO_FACTOR_PREVIOUS_ENCRYPTION_KEYS=

TWO_FACTOR_ISSUER=Zoosper
TWO_FACTOR_PERIOD=30
TWO_FACTOR_DIGITS=6
TWO_FACTOR_WINDOW=1
TWO_FACTOR_RECOVERY_CODES=8

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=storage/database/zoosper.sqlite

# MySQL example
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=zoosper
# DB_USERNAME=root
# DB_PASSWORD=secret

DATABASE_PRODUCTION_DRIVER=mysql
DATABASE_ALLOW_SQLITE_LOCAL=true
DATABASE_ENFORCE_MYSQL_PRODUCTION=true

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_NAME=ZOOSPERSESSID
# Local quick start uses HTTP, so Secure cookies must remain disabled here.
# Staging and production are rejected at boot unless SESSION_SECURE=true.
SESSION_SECURE=false

# -----------------------------------------------------------------------------
# Default site
# -----------------------------------------------------------------------------
DEFAULT_SITE_CODE=main
DEFAULT_SITE_NAME="Main Website"
DEFAULT_SITE_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Version
# -----------------------------------------------------------------------------
# Optional deployment override. Leave unset to use config/version.php.
# CMS_VERSION=0.1.0-alpha.1

# -----------------------------------------------------------------------------
# Static assets
# -----------------------------------------------------------------------------
# Keep static paths separate from application routes such as /admin.
ASSET_BASE_PATH=/assets
ADMIN_ASSET_PATH=/assets/admin
# Seconds of Admin inactivity before authenticated and pending-2FA state expires. 0 disables expiry.
ADMIN_SESSION_IDLE_TIMEOUT=7200
# Outer PHP session and browser-cookie lifetime, bounded to 300..604800 seconds.
SESSION_LIFETIME_SECONDS=28800
# Lax, Strict or None. None requires a secure cookie and otherwise falls back to Lax.
SESSION_SAMESITE=Lax
# Optional explicit override. When omitted, the current HTTPS request detection is used.
# SESSION_SECURE=true
# Comma-separated immediate proxy IPs allowed to supply forwarded scheme/client metadata.
TRUSTED_PROXIES=
FRONTEND_ASSET_PATH=/assets/frontend
MODULE_ASSET_PATH=/assets/modules

# -----------------------------------------------------------------------------
# Admin large-content editor
# -----------------------------------------------------------------------------
# Keep disabled by default until editor assets and content sanitisation are wired.
ADMIN_WYSIWYG_ENABLED=false
ADMIN_WYSIWYG_PROVIDER=editorjs
ADMIN_WYSIWYG_STORE_FORMAT=json

# -----------------------------------------------------------------------------
# Admin tag selector
# -----------------------------------------------------------------------------
# Progressive enhancement for safe tag-style multi-selection.
ADMIN_TAG_SELECTOR_ENABLED=true
ADMIN_TAG_SELECTOR_MAX_VISIBLE_OPTIONS=25

# -----------------------------------------------------------------------------
# Mail / SMTP
# -----------------------------------------------------------------------------
# Keep SMTP passwords in environment variables or secret storage only.
# Do not commit real SMTP credentials.
MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=Zoosper

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
SMTP_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# HTML sanitisation
# -----------------------------------------------------------------------------
# "htmlpurifier" (default, recommended) is the real, robust sanitizer.
# "basic" is a conservative regex-based fallback for local dev ONLY, when
# ezyang/htmlpurifier is not installed yet — its own docs admit it is
# bypassable, so it REQUIRES the explicit confirmation flag below as well
# as selecting the driver; setting the driver alone is not enough.
HTML_SANITIZER_DRIVER=htmlpurifier
HTML_SANITIZER_ALLOW_BASIC_DRIVER=false
HTML_SANITIZER_CACHE_PATH=var/cache/htmlpurifier
# HTML_SANITIZER_ALLOWED_ELEMENTS=p,br,strong,b,em,i,u,ul,ol,li,a[href|title|target|rel],h2,h3,h4,h5,h6,blockquote,pre,code,img[src|alt|title|width|height],table,thead,tbody,tr,th,td
HTML_SANITIZER_ALLOWED_SCHEMES=http,https,mailto,tel
HTML_SANITIZER_STRIP_EMPTY=true

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Disabled for the zero-configuration local quick start. Before enabling, set a
# stable random RATE_LIMIT_IDENTITY_SALT. Staging and production require enabled
# enforce mode plus a strong salt and fail boot when any requirement is missing.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MODE=report_only
RATE_LIMIT_REPORT_PATH=var/reports/rate-limit-events.jsonl
# REQUIRED before setting RATE_LIMIT_ENABLED=true. Without a real salt, the
# stored identity hash is vulnerable to dictionary/rainbow-table attacks.
# Generate a stable secret with: php -r "echo bin2hex(random_bytes(32));"
RATE_LIMIT_IDENTITY_SALT=
RATE_LIMIT_ADMIN_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_ADMIN_TWO_FACTOR_MAX_ATTEMPTS=5
RATE_LIMIT_ADMIN_TWO_FACTOR_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Cache (Marko-backed: file driver by default, Redis for production/
# high-traffic deployments — see ROADMAP.md §14/§15)
# -----------------------------------------------------------------------------
CACHE_DRIVER=file
CACHE_PATH=var/cache/page
CACHE_TTL=3600

# Only read when CACHE_DRIVER=redis. Requires a running, reachable Redis
# server — the app fails open (falls back to normal, uncached behaviour)
# if Redis is unreachable, it never breaks a page load because of this.
CACHE_REDIS_HOST=127.0.0.1
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DATABASE=0
CACHE_REDIS_PREFIX=zoosper:cache:

# Only relevant when CACHE_DRIVER=redis — signs cached values with
# HMAC-SHA256 to detect tampering/corruption in the Redis store. Dedicated
# key, never reuse APP_KEY/TWO_FACTOR_ENCRYPTION_KEY for this. Generate the
# same way as any other key above.
CACHE_ENCRYPTION_KEY=
CACHE_ENCRYPTION_CIPHER=aes-256-gcm

# -----------------------------------------------------------------------------
# Frontend page cache (disabled by default — a page cache that ever serves
# stale or wrong content is worse than no cache at all; this must be a
# deliberate opt-in). Uses whichever backend CACHE_DRIVER above selects.
# -----------------------------------------------------------------------------
PAGE_CACHE_ENABLED=false
PAGE_CACHE_TTL=300

# API CORS is disabled until exact trusted origins are configured.
API_CORS_ENABLED=false
API_CORS_ALLOWED_ORIGINS=
API_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
API_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-CSRF-Token
API_CORS_EXPOSED_HEADERS=ETag,Retry-After
API_CORS_ALLOW_CREDENTIALS=false
API_CORS_MAX_AGE=600

# Node.js API
STORE_ORDERS_API_BASE_URL=http://127.0.0.1:3000